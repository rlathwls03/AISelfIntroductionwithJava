<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFDF5" /> <!-- 배경색 -->
            <stroke android:width="1dp" android:color="#F2E4B7" /> <!-- 테두리 -->
            <corners android:radius="12dp" /> <!-- 모서리 둥글게 -->
            <padding
                android:left="12dp"
                android:top="10dp"
                android:right="12dp"
                android:bottom="10dp" />
        </shape>
    </item>
</selector>