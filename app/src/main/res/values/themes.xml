<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AISelfIntroduction" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#FCD965</item>
        <item name="colorPrimaryVariant">#F9C449</item>
        <item name="colorOnPrimary">#000000</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">#FFF3C6</item>
        <item name="colorSecondaryVariant">#F2E4B7</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- 팝업 메뉴 스타일 적용 -->
        <item name="popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:textAppearance">@style/PopupMenuTextStyle</item>
        <item name="android:dropDownListViewStyle">@style/PopupMenuListView</item>
    </style>
</resources>
