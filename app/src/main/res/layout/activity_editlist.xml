<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCF4"
    android:padding="24dp"
    android:paddingTop="32dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 헤더 (닫기 + 타이틀 + 홈) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close"
                android:background="@android:color/transparent"
                android:contentDescription="닫기" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI 자기소개서"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_home"
                android:background="@android:color/transparent"
                android:contentDescription="홈" />
        </LinearLayout>

        <!-- 설명 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI가 생성한 자기소개서를 자유롭게 수정"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="항목이 생성되면 편집 버튼이 활성화됩니다.\n하단 버튼을 눌러 편집을 시작하세요.\n옆으로 스와이프하여 문항을 이동하며 수정 가능합니다."
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- 자기소개서 정보 박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFF1C4"
            android:padding="12dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_document"
                android:layout_marginEnd="8dp"
                android:contentDescription="문서" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="테스트 자기소개서"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ✅ 항목별 편집 버튼들 -->
        <Button
            android:id="@+id/btnRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="직무 역량"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="#888888"
            android:enabled="false" />

        <Button
            android:id="@+id/btnGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="입사 후 포부"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="#888888"
            android:enabled="false" />

        <Button
            android:id="@+id/btnReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="지원 동기"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="#888888"
            android:enabled="false" />

        <Button
            android:id="@+id/btnPersonality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="성격의 장단점"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="#888888"
            android:enabled="false" />

        <!-- 전체 편집 시작 버튼 -->
        <Button
            android:id="@+id/btnEditAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI 자기소개서 편집 시작"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#FFD54F"
            android:layout_marginBottom="24dp" />

        <!-- 안내 문구 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="각 항목은 최대 1000자까지 입력 가능합니다."
            android:textSize="12sp"
            android:textColor="#888"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>